{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Wraps .open-next/worker.js to add the reminders cron (see the file).
  "main": "custom-worker.ts",
  "name": "vivaah",
  // 03:30 UTC is 09:00 IST, the hour COMMS_FLOW_SPEC v1.0 set for reminders.
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  // The shop's details as the owner saves them in Settings, mirrored out of
  // Neon so the footer on every route can read them without waking the
  // database (lib/shopInfo.ts). Free tier.
  "kv_namespaces": [
    {
      "binding": "SHOP_KV",
      "id": "9890c7e316a94d52bdfadb67bde0d58b"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
