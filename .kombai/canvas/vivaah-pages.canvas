    "var_f122957d8a4a": {
      "type": "variant",
      "label": "/policies — A: Sticky index + numbered terms",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;1,6..96,500&family=Instrument+Sans:wght@400;500;600&display=swap');\n.vv{\n--violet-950:#191129;--violet-900:#221636;--violet-800:#2f1e4d;--violet-700:#40296a;--violet-500:#6e56a6;--violet-300:#b3a4d6;--violet-100:#ede9f7;\n--porcelain-50:#fafaf7;--porcelain-100:#f2f1ec;--porcelain-200:#e4e2da;--stage:#ecebe7;\n--ink-900:#241d31;--ink-600:#5d5668;--ink-400:#8e8798;\n--gold-600:#a9853a;--gold-500:#c2a155;--gold-100:#f4eedc;\nfont-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;color:var(--ink-900);background:var(--porcelain-50);\nfont-size:1.0625rem;line-height:1.65;-webkit-font-smoothing:antialiased;\n}\n.vv .display{font-family:'Bodoni Moda',Georgia,serif;font-weight:500;font-optical-sizing:auto;}\n.vv .eyebrow{font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;font-weight:500;color:var(--gold-600);}\n.vv .eyebrow.on-dark{color:var(--gold-500);}\n.vv .shell{width:100%;max-width:1200px;margin-inline:auto;padding-inline:2rem;}\n.vv .shell-wide{width:100%;max-width:1600px;margin-inline:auto;padding-inline:2.5rem;}\n.vv .tabular{font-variant-numeric:tabular-nums;}\n.vv .ornament{display:flex;align-items:center;gap:1rem;color:var(--gold-500);}\n.vv .ornament::before,.vv .ornament::after{content:\"\";flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(194,161,85,.65));}\n.vv .ornament::before{background:linear-gradient(to left,transparent,rgba(194,161,85,.65));}\n.vv .edge{position:absolute;left:0;right:0;top:-6px;height:104px;pointer-events:none;}\n.vv .edge svg{width:100%;height:100%;display:block;}\n.vv [data-reveal]{opacity:0;transform:translateY(18px);}\n.vv .h1-letter{display:inline-block;opacity:0;transform:translateY(.35em);}\n.vv .idx a{display:flex;gap:1rem;align-items:baseline;padding:.65rem 0 .65rem 1.25rem;position:relative;color:var(--ink-600);text-decoration:none;transition:color 180ms;}\n.vv .idx a::before{content:\"\";position:absolute;left:0;top:.9rem;bottom:.9rem;width:1px;background:var(--gold-600);opacity:0;transform:scaleY(.4);transform-origin:center;transition:opacity 180ms,transform 180ms;}\n.vv .idx a.is-active{color:var(--ink-900);}\n.vv .idx a.is-active::before{opacity:1;transform:scaleY(1);}\n.vv .idx a:hover{color:var(--ink-900);}\n.vv .btn{display:inline-block;border-radius:10px;padding:.8rem 1.5rem;font-weight:500;text-decoration:none;transition:background-color 180ms,border-color 180ms;}\n.vv .btn-primary{background:var(--violet-800);color:var(--porcelain-50);}\n.vv .btn-primary:hover{background:var(--violet-700);}\n.vv .btn-ghost{border:1px solid rgba(36,29,49,.2);color:var(--ink-900);}\n.vv .btn-ghost:hover{border-color:rgba(36,29,49,.4);}\n@media (prefers-reduced-motion: reduce){\n .vv [data-reveal],.vv .h1-letter{opacity:1;transform:none;}\n .vv *{transition-duration:.001ms!important;}\n}\n</style>\n<div class=\"vv\" data-kid=\"1\">\n    <!-- ================= NAV (site chrome, provided by layout) ================= -->\n    <header class=\"bg-[var(--porcelain-50)] border-b border-[var(--porcelain-200)]\" data-kid=\"1-1\">\n        <div class=\"shell-wide flex items-center justify-between h-16\" data-kid=\"1-1-1\">\n            <a class=\"leading-none\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"display block text-[1.35rem] text-[var(--ink-900)]\" data-kid=\"1-1-1-1-1\">\n                    Vivaah\n                </span>\n                <span class=\"block text-[.5rem] tracking-[.2em] uppercase text-[var(--gold-600)] font-medium mt-0.5\" data-kid=\"1-1-1-1-2\">\n                    Dresses & Suits\n                </span>\n            </a>\n            <nav class=\"hidden md:flex gap-9 text-[.95rem] text-[var(--ink-600)]\" data-kid=\"1-1-1-2\">\n                <a class=\"hover:text-[var(--ink-900)]\" data-kid=\"1-1-1-2-1\" href=\"#\">\n                    Rent\n                </a>\n                <a class=\"hover:text-[var(--ink-900)]\" data-kid=\"1-1-1-2-2\" href=\"#\">\n                    Shop\n                </a>\n                <a class=\"hover:text-[var(--ink-900)]\" data-kid=\"1-1-1-2-3\" href=\"#\">\n                    Jewellery\n                </a>\n                <a class=\"hover:text-[var(--ink-900)]\" data-kid=\"1-1-1-2-4\" href=\"#\">\n                    Visit us\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n                <div class=\"flex rounded-full border border-[var(--porcelain-200)] p-0.5 text-[.75rem] font-medium\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"rounded-full bg-[var(--violet-950)] text-[var(--porcelain-50)] px-2.5 py-1\" data-kid=\"1-1-1-3-1-1\">\n                        EN\n                    </span>\n                    <span class=\"px-2.5 py-1 text-[var(--ink-600)]\" data-kid=\"1-1-1-3-1-2\">\n                        हिं\n                    </span>\n                </div>\n                <a class=\"btn btn-ghost text-[.95rem] !py-2.5 !px-5\" data-kid=\"1-1-1-3-2\" href=\"#\">\n                    Book a trial\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ================= 1. HEAD ================= -->\n    <section class=\"relative bg-[var(--porcelain-50)] pt-24 pb-24 md:pt-28 md:pb-28\" data-kid=\"1-2\">\n        <div class=\"shell-wide\" data-kid=\"1-2-1\">\n            <p class=\"eyebrow\" data-kid=\"1-2-1-1\" data-reveal=\"\">\n                Rental terms\n            </p>\n            <div class=\"mt-6 grid gap-10 lg:grid-cols-[1.55fr_1fr] lg:items-end\" data-kid=\"1-2-1-2\">\n                <h1 aria-label=\"The terms, kept plain.\" class=\"display text-[var(--ink-900)] text-[clamp(2.5rem,1.7rem+3.4vw,4rem)] leading-[1.06] tracking-[-0.01em]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1\" data-name=\"hero headline text with split characters\" data-reason=\"text characters wrapped in spans by splitNode script\" id=\"h1\">\n                    The terms, kept\n                    <em class=\"italic\" data-kid=\"1-2-1-2-1-1\">\n                        plain.\n                    </em>\n                </h1>\n                <p class=\"text-[1.25rem] leading-[1.5] text-[var(--ink-600)] max-w-[34ch] lg:pb-2 lg:justify-self-end\" data-kid=\"1-2-1-2-2\" data-reveal=\"\">\n                    What is expected of you when you take a garment out, and what the shop does in return.\n                </p>\n            </div>\n            <div class=\"mt-16 grid sm:grid-cols-3 border-t border-b border-[var(--ink-900)]/10\" data-kid=\"1-2-1-3\" data-reveal=\"\">\n                <div class=\"flex items-baseline gap-4 py-4 pr-6 sm:border-r border-[var(--ink-900)]/10\" data-kid=\"1-2-1-3-1\">\n                    <span class=\"tabular text-[.8125rem] text-[var(--gold-600)]\" data-kid=\"1-2-1-3-1-1\">\n                        01\n                    </span>\n                    <span class=\"text-[.8125rem] text-[var(--ink-400)]\" data-kid=\"1-2-1-3-1-2\">\n                        Applies to rentals\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-4 py-4 sm:px-6 sm:border-r border-[var(--ink-900)]/10\" data-kid=\"1-2-1-3-2\">\n                    <span class=\"tabular text-[.8125rem] text-[var(--gold-600)]\" data-kid=\"1-2-1-3-2-1\">\n                        02\n                    </span>\n                    <span class=\"text-[.8125rem] text-[var(--ink-400)]\" data-kid=\"1-2-1-3-2-2\">\n                        Retail and jewellery: see in shop\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-4 py-4 sm:pl-6\" data-kid=\"1-2-1-3-3\">\n                    <span class=\"tabular text-[.8125rem] text-[var(--gold-600)]\" data-kid=\"1-2-1-3-3-1\">\n                        03\n                    </span>\n                    <span class=\"text-[.8125rem] text-[var(--ink-400)]\" data-kid=\"1-2-1-3-3-2\">\n                        Status: being finalised\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 2. THE TERMS ================= -->\n    <section class=\"relative bg-[var(--porcelain-100)] pt-32 pb-28 md:pt-40 md:pb-36\" data-kid=\"1-3\">\n        <div aria-hidden=\"true\" class=\"edge\" data-dynamic=\"true\" data-kid=\"1-3-1\" data-name=\"torn paper edge graphic\" data-paper=\"#fafaf7\" data-reason=\"content rendered/injected by torn-paper script\" data-seed=\"21\">\n        </div>\n        <div class=\"shell-wide\" data-kid=\"1-3-2\">\n            <div class=\"grid gap-16 lg:grid-cols-[300px_1fr] lg:gap-24\" data-kid=\"1-3-2-1\">\n                <!-- Sticky index -->\n                <aside class=\"hidden lg:block\" data-kid=\"1-3-2-1-1\">\n                    <div class=\"sticky top-24\" data-kid=\"1-3-2-1-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-3-2-1-1-1-1\">\n                            Index\n                        </p>\n                        <nav class=\"idx mt-5 border-l border-[var(--ink-900)]/10\" data-kid=\"1-3-2-1-1-1-2\">\n                            <a class=\"is-active\" data-idx=\"term-a\" data-kid=\"1-3-2-1-1-1-2-1\" href=\"#term-a\">\n                                <span class=\"display text-[var(--gold-600)] text-[1.05rem] w-4 shrink-0\" data-kid=\"1-3-2-1-1-1-2-1-1\">\n                                    A\n                                </span>\n                                <span data-kid=\"1-3-2-1-1-1-2-1-2\">\n                                    Booking and pre-payment\n                                </span>\n                            </a>\n                            <a data-idx=\"term-b\" data-kid=\"1-3-2-1-1-1-2-2\" href=\"#term-b\">\n                                <span class=\"display text-[var(--gold-600)] text-[1.05rem] w-4 shrink-0\" data-kid=\"1-3-2-1-1-1-2-2-1\">\n                                    B\n                                </span>\n                                <span data-kid=\"1-3-2-1-1-1-2-2-2\">\n                                    Extensions\n                                </span>\n                            </a>\n                            <a data-idx=\"term-c\" data-kid=\"1-3-2-1-1-1-2-3\" href=\"#term-c\">\n                                <span class=\"display text-[var(--gold-600)] text-[1.05rem] w-4 shrink-0\" data-kid=\"1-3-2-1-1-1-2-3-1\">\n                                    C\n                                </span>\n                                <span data-kid=\"1-3-2-1-1-1-2-3-2\">\n                                    Damage and care\n                                </span>\n                            </a>\n                            <a data-idx=\"term-d\" data-kid=\"1-3-2-1-1-1-2-4\" href=\"#term-d\">\n                                <span class=\"display text-[var(--gold-600)] text-[1.05rem] w-4 shrink-0\" data-kid=\"1-3-2-1-1-1-2-4-1\">\n                                    D\n                                </span>\n                                <span data-kid=\"1-3-2-1-1-1-2-4-2\">\n                                    Pickup and return\n                                </span>\n                            </a>\n                            <a data-idx=\"term-e\" data-kid=\"1-3-2-1-1-1-2-5\" href=\"#term-e\">\n                                <span class=\"display text-[var(--gold-600)] text-[1.05rem] w-4 shrink-0\" data-kid=\"1-3-2-1-1-1-2-5-1\">\n                                    E\n                                </span>\n                                <span data-kid=\"1-3-2-1-1-1-2-5-2\">\n                                    Being finalised\n                                </span>\n                            </a>\n                        </nav>\n                        <p class=\"mt-10 text-[.8125rem] text-[var(--ink-400)] max-w-[26ch]\" data-kid=\"1-3-2-1-1-1-3\">\n                            Full terms appear here in English and Hindi once the shop sets them.\n                        </p>\n                    </div>\n                </aside>\n                <!-- Lettered sections -->\n                <div class=\"lg:pl-28\" data-kid=\"1-3-2-1-2\">\n                    <article class=\"relative py-6 lg:py-10 border-b border-[var(--ink-900)]/10\" data-kid=\"1-3-2-1-2-1\" data-term=\"\" id=\"term-a\">\n                        <span aria-hidden=\"true\" class=\"display absolute -left-28 top-2 hidden lg:block text-[7rem] leading-none text-[var(--gold-600)]/30 select-none\" data-kid=\"1-3-2-1-2-1-1\">\n                            A\n                        </span>\n                        <p class=\"eyebrow lg:hidden\" data-kid=\"1-3-2-1-2-1-2\">\n                            A\n                        </p>\n                        <h2 class=\"display text-[var(--ink-900)] text-[clamp(1.875rem,1.45rem+1.85vw,2.625rem)] leading-[1.15] tracking-[-0.004em] mt-2 lg:mt-0\" data-kid=\"1-3-2-1-2-1-3\" data-reveal=\"\">\n                            Booking and\n                            <em class=\"italic\" data-kid=\"1-3-2-1-2-1-3-1\">\n                                pre-payment\n                            </em>\n                        </h2>\n                        <p class=\"mt-6 max-w-[62ch] text-[var(--ink-600)]\" data-kid=\"1-3-2-1-2-1-4\" data-reveal=\"\">\n                            How much to pay up front to secure your dates, the UPI details we accept, and how the balance is settled.\n                        </p>\n                    </article>\n                    <article class=\"relative py-16 lg:py-24 border-b border-[var(--ink-900)]/10\" data-kid=\"1-3-2-1-2-2\" data-term=\"\" id=\"term-b\">\n                        <span aria-hidden=\"true\" class=\"display absolute -left-28 top-[4.5rem] hidden lg:block text-[7rem] leading-none text-[var(--gold-600)]/30 select-none\" data-kid=\"1-3-2-1-2-2-1\">\n                            B\n                        </span>\n                        <p class=\"eyebrow lg:hidden\" data-kid=\"1-3-2-1-2-2-2\">\n                            B\n                        </p>\n                        <h2 class=\"display text-[var(--ink-900)] text-[clamp(1.875rem,1.45rem+1.85vw,2.625rem)] leading-[1.15] tracking-[-0.004em] mt-2 lg:mt-0\" data-kid=\"1-3-2-1-2-2-3\" data-reveal=\"\">\n                            Extensions\n                        </h2>\n                        <p class=\"mt-6 max-w-[62ch] text-[var(--ink-600)]\" data-kid=\"1-3-2-1-2-2-4\" data-reveal=\"\">\n                            Keeping a piece for a few\n                            <em class=\"display italic text-[var(--ink-900)]\" data-kid=\"1-3-2-1-2-2-4-1\">\n                                extra\n                            </em>\n                            days, and how additional dates are arranged when they are free.\n                        </p>\n                    </article>\n                    <article class=\"relative py-16 lg:py-24 border-b border-[var(--ink-900)]/10\" data-kid=\"1-3-2-1-2-3\" data-term=\"\" id=\"term-c\">\n                        <span aria-hidden=\"true\" class=\"display absolute -left-28 top-[4.5rem] hidden lg:block text-[7rem] leading-none text-[var(--gold-600)]/30 select-none\" data-kid=\"1-3-2-1-2-3-1\">\n                            C\n                        </span>\n                        <p class=\"eyebrow lg:hidden\" data-kid=\"1-3-2-1-2-3-2\">\n                            C\n                        </p>\n                        <h2 class=\"display text-[var(--ink-900)] text-[clamp(1.875rem,1.45rem+1.85vw,2.625rem)] leading-[1.15] tracking-[-0.004em] mt-2 lg:mt-0\" data-kid=\"1-3-2-1-2-3-3\" data-reveal=\"\">\n                            Damage and\n                            <em class=\"italic\" data-kid=\"1-3-2-1-2-3-3-1\">\n                                care\n                            </em>\n                        </h2>\n                        <p class=\"mt-6 max-w-[62ch] text-[var(--ink-600)]\" data-kid=\"1-3-2-1-2-3-4\" data-reveal=\"\">\n                            Caring for your outfit through the celebration, and how accidental marks or damage are handled on return.\n                        </p>\n                    </article>\n                    <article class=\"relative py-16 lg:py-24\" data-kid=\"1-3-2-1-2-4\" data-term=\"\" id=\"term-d\">\n                        <span aria-hidden=\"true\" class=\"display absolute -left-28 top-[4.5rem] hidden lg:block text-[7rem] leading-none text-[var(--gold-600)]/30 select-none\" data-kid=\"1-3-2-1-2-4-1\">\n                            D\n                        </span>\n                        <p class=\"eyebrow lg:hidden\" data-kid=\"1-3-2-1-2-4-2\">\n                            D\n                        </p>\n                        <h2 class=\"display text-[var(--ink-900)] text-[clamp(1.875rem,1.45rem+1.85vw,2.625rem)] leading-[1.15] tracking-[-0.004em] mt-2 lg:mt-0\" data-kid=\"1-3-2-1-2-4-3\" data-reveal=\"\">\n                            Pickup and\n                            <em class=\"italic\" data-kid=\"1-3-2-1-2-4-3-1\">\n                                return\n                            </em>\n                        </h2>\n                        <p class=\"mt-6 max-w-[62ch] text-[var(--ink-600)]\" data-kid=\"1-3-2-1-2-4-4\" data-reveal=\"\">\n                            Collecting before your day and returning it after: everything happens at the shop, with no shipping.\n                        </p>\n                    </article>\n                    <div aria-hidden=\"true\" class=\"ornament max-w-[14rem] mt-6\" data-kid=\"1-3-2-1-2-5\">\n                        ✦\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 3. BEING FINALISED ================= -->\n    <section class=\"relative bg-[var(--stage)] pt-36 pb-28 md:pt-44 md:pb-36\" data-kid=\"1-4\" data-term=\"\" id=\"term-e\">\n        <div aria-hidden=\"true\" class=\"edge\" data-dynamic=\"true\" data-kid=\"1-4-1\" data-name=\"torn paper edge graphic\" data-paper=\"#f2f1ec\" data-reason=\"content rendered/injected by torn-paper script\" data-seed=\"22\">\n        </div>\n        <div class=\"shell-wide\" data-kid=\"1-4-2\">\n            <div class=\"grid gap-12 lg:grid-cols-[45fr_55fr] lg:gap-20 items-start\" data-kid=\"1-4-2-1\">\n                <div data-kid=\"1-4-2-1-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-4-2-1-1-1\" data-reveal=\"\">\n                        <span class=\"display text-[var(--gold-600)] normal-case tracking-normal text-[1rem] mr-3\" data-kid=\"1-4-2-1-1-1-1\">\n                            E\n                        </span>\n                        Being finalised\n                    </p>\n                    <h2 class=\"display mt-5 text-[var(--ink-900)] text-[clamp(1.875rem,1.45rem+1.85vw,2.625rem)] leading-[1.15] tracking-[-0.004em] max-w-[18ch]\" data-kid=\"1-4-2-1-1-2\" data-reveal=\"\">\n                        Full terms are being\n                        <em class=\"italic\" data-kid=\"1-4-2-1-1-2-1\">\n                            set\n                        </em>\n                        by the shop.\n                    </h2>\n                </div>\n                <div class=\"lg:pt-10\" data-kid=\"1-4-2-1-2\">\n                    <p class=\"text-[var(--ink-600)] max-w-[58ch]\" data-kid=\"1-4-2-1-2-1\" data-reveal=\"\">\n                        Full terms are being set by the shop through its admin panel, and will appear here in both English and Hindi. Until then, our team will walk you through everything in person or over the phone.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap gap-3\" data-kid=\"1-4-2-1-2-2\" data-reveal=\"\">\n                        <a class=\"btn btn-primary\" data-kid=\"1-4-2-1-2-2-1\" href=\"/visit\">\n                            Visit the shop\n                        </a>\n                        <a class=\"btn btn-ghost\" data-kid=\"1-4-2-1-2-2-2\" href=\"/rentals\">\n                            Explore rentals\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= FOOTER (site chrome) ================= -->\n    <footer class=\"relative bg-[var(--violet-950)] text-[var(--violet-300)] pt-24 pb-10\" data-kid=\"1-5\">\n        <div class=\"shell-wide\" data-kid=\"1-5-1\">\n            <div class=\"grid gap-12 md:grid-cols-[1.3fr_1fr_1fr]\" data-kid=\"1-5-1-1\">\n                <div data-kid=\"1-5-1-1-1\">\n                    <span class=\"display block text-[1.5rem] text-[var(--porcelain-50)] leading-none\" data-kid=\"1-5-1-1-1-1\">\n                        Vivaah\n                    </span>\n                    <span class=\"block text-[.5rem] tracking-[.2em] uppercase text-[var(--gold-500)] font-medium mt-1\" data-kid=\"1-5-1-1-1-2\">\n                        Dresses & Suits\n                    </span>\n                    <p class=\"mt-6 max-w-[30ch] text-[.95rem]\" data-kid=\"1-5-1-1-1-3\">\n                        Bridal and festive wear to rent or buy, with jewellery to match.\n                    </p>\n                </div>\n                <div data-kid=\"1-5-1-1-2\">\n                    <p class=\"eyebrow on-dark\" data-kid=\"1-5-1-1-2-1\">\n                        Explore\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[.95rem]\" data-kid=\"1-5-1-1-2-2\">\n                        <li data-kid=\"1-5-1-1-2-2-1\">\n                            <a class=\"hover:text-[var(--porcelain-50)]\" data-kid=\"1-5-1-1-2-2-1-1\" href=\"#\">\n                                Rent\n                            </a>\n                        </li>\n                        <li data-kid=\"1-5-1-1-2-2-2\">\n                            <a class=\"hover:text-[var(--porcelain-50)]\" data-kid=\"1-5-1-1-2-2-2-1\" href=\"#\">\n                                Shop\n                            </a>\n                        </li>\n                        <li data-kid=\"1-5-1-1-2-2-3\">\n                            <a class=\"hover:text-[var(--porcelain-50)]\" data-kid=\"1-5-1-1-2-2-3-1\" href=\"#\">\n                                Jewellery\n                            </a>\n                        </li>\n                        <li data-kid=\"1-5-1-1-2-2-4\">\n                            <a class=\"hover:text-[var(--porcelain-50)]\" data-kid=\"1-5-1-1-2-2-4-1\" href=\"#\">\n                                Visit us\n                            </a>\n                        </li>\n                        <li data-kid=\"1-5-1-1-2-2-5\">\n                            <a class=\"text-[var(--porcelain-50)]\" data-kid=\"1-5-1-1-2-2-5-1\" href=\"#\">\n                                Rental terms\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-5-1-1-3\">\n                    <p class=\"eyebrow on-dark\" data-kid=\"1-5-1-1-3-1\">\n                        Visit us\n                    </p>\n                    <p class=\"mt-5 text-[var(--porcelain-50)] text-[.95rem]\" data-kid=\"1-5-1-1-3-2\">\n                        Shop address, City\n                    </p>\n                    <a class=\"text-[.95rem] text-[var(--gold-500)] hover:underline underline-offset-4\" data-kid=\"1-5-1-1-3-3\" href=\"#\">\n                        Get directions\n                    </a>\n                    <p class=\"mt-4 text-[.95rem] tabular\" data-kid=\"1-5-1-1-3-4\">\n                        Mon–Sat, 11am – 8pm\n                    </p>\n                    <p class=\"mt-1 text-[.95rem] tabular\" data-kid=\"1-5-1-1-3-5\">\n                        +91 00000 00000\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-16 border-t border-[var(--porcelain-50)]/10 pt-6 flex flex-wrap justify-between gap-4 text-[.8125rem] text-[var(--violet-500)]\" data-kid=\"1-5-1-2\">\n                <span data-kid=\"1-5-1-2-1\">\n                    © Vivaah Dresses and Suits. Reserve online, collect at our shop.\n                </span>\n                <span data-kid=\"1-5-1-2-2\">\n                    Made for weddings, in India.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    (function(){\n  /* ---- Torn-paper edges (port of SectionEdge.tsx) ---- */\n  function prng(seed){let a=seed>>>0;return function(){a=(a+0x6d2b79f5)>>>0;let t=Math.imul(a^(a>>>15),1|a);t=(t+Math.imul(t^(t>>>7),61|t))^t;return((t^(t>>>14))>>>0)/4294967296;}}\n  function mix(hex,k,to){const n=parseInt(hex.slice(1),16),r=n>>16,g=(n>>8)&255,b=n&255,T=to==='w'?255:0;const f=v=>Math.round(v*k+T*(1-k));return `rgb(${f(r)},${f(g)},${f(b)})`;}\n  function torn(paper,seed){\n    const W=1600,H=160,TY=52,step=16,n=Math.ceil(W/step),rnd=prng(seed);\n    const wander=[];let w=0;for(let i=0;i<=n;i++){w+=(rnd()-.5)*11;w=Math.max(-30,Math.min(30,w));wander.push(w);}\n    const ys=wander.map(v=>{const s=rnd()<.08?(rnd()-.5)*34:0;return TY+v+(rnd()-.5)*13+s;});\n    let tear=`M0 0 L${W} 0 L${W} ${ys[n].toFixed(1)}`;for(let i=n-1;i>=0;i--)tear+=` L${i*step} ${ys[i].toFixed(1)}`;tear+=' Z';\n    const curls=[];const count=3+Math.floor(rnd()*2);\n    for(let k=0;k<count;k++){const lane=(k+.5)/count;const c=lane*W+(rnd()-.5)*(W/count)*.4;const half=38+rnd()*34;const x0=Math.max(-40,c-half),x1=Math.min(W+40,c+half);const depth=74+rnd()*26,lift=3+rnd()*4;\n      const iS=Math.max(0,Math.round(x0/step)),iE=Math.min(n,Math.round(x1/step));\n      let top=`M${iS*step} ${ys[iS].toFixed(1)}`;for(let i=iS+1;i<=iE;i++)top+=` L${i*step} ${ys[i].toFixed(1)}`;\n      const yMid=ys[Math.round((iS+iE)/2)],belly=yMid+depth;\n      const under=(o)=>` C ${(x1-half*.06).toFixed(0)} ${(ys[iE]+lift+depth*.55+o*0.73).toFixed(1)}, ${(c+half*.72).toFixed(0)} ${(belly+o).toFixed(1)}, ${c.toFixed(0)} ${(belly+o).toFixed(1)} C ${(c-half*.72).toFixed(0)} ${(belly+o).toFixed(1)}, ${(x0+half*.06).toFixed(0)} ${(ys[iS]+lift+depth*.55+o*0.73).toFixed(1)}, ${iS*step} ${ys[iS].toFixed(1)} Z`;\n      curls.push({d:top+under(0),shadow:top+under(11)});}\n    let ts=`M0 ${(ys[0]-6).toFixed(1)}`;for(let i=1;i<=n;i++)ts+=` L${i*step} ${(ys[i]-6).toFixed(1)}`;for(let i=n;i>=0;i--)ts+=` L${i*step} ${(ys[i]+9).toFixed(1)}`;ts+=' Z';\n    const id='e'+seed;\n    return `<svg viewBox=\"0 0 ${W} ${H}\" preserveAspectRatio=\"none\"><defs>\n      <linearGradient id=\"${id}r\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"${mix(paper,.44,'b')}\"/><stop offset=\"14%\" stop-color=\"${mix(paper,.66,'b')}\"/>\n        <stop offset=\"26%\" stop-color=\"${mix(paper,.40,'w')}\"/><stop offset=\"33%\" stop-color=\"${mix(paper,.72,'w')}\"/>\n        <stop offset=\"46%\" stop-color=\"${paper}\"/><stop offset=\"72%\" stop-color=\"${mix(paper,.70,'b')}\"/>\n        <stop offset=\"92%\" stop-color=\"${mix(paper,.42,'b')}\"/><stop offset=\"100%\" stop-color=\"${mix(paper,.30,'b')}\"/>\n      </linearGradient>\n      <filter id=\"${id}b\" x=\"-10%\" y=\"-30%\" width=\"120%\" height=\"180%\"><feGaussianBlur stdDeviation=\"5\"/></filter></defs>\n      <path d=\"${tear}\" fill=\"${paper}\"/>\n      <g filter=\"url(#${id}b)\" opacity=\".22\"><path d=\"${ts}\" fill=\"#000\"/></g>\n      <g filter=\"url(#${id}b)\" opacity=\".28\">${curls.map(c=>`<path d=\"${c.shadow}\" fill=\"#000\"/>`).join('')}</g>\n      ${curls.map(c=>`<path d=\"${c.d}\" fill=\"url(#${id}r)\"/>`).join('')}\n    </svg>`;\n  }\n  document.querySelectorAll('.vv .edge').forEach(el=>{el.innerHTML=torn(el.dataset.paper,+el.dataset.seed);});\n\n  /* ---- Sticky index active state ---- */\n  const links=[...document.querySelectorAll('.vv .idx a')];\n  const setActive=id=>links.forEach(a=>a.classList.toggle('is-active',a.dataset.idx===id));\n  if('IntersectionObserver' in window){\n    const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)setActive(e.target.id);});},{rootMargin:'-35% 0px -55% 0px'});\n    document.querySelectorAll('.vv [data-term]').forEach(t=>io.observe(t));\n  }\n\n  /* ---- Motion ---- */\n  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const h1=document.getElementById('h1');\n  // split h1 into letters (keeps <em>)\n  const splitNode=node=>{[...node.childNodes].forEach(ch=>{if(ch.nodeType===3){const frag=document.createDocumentFragment();[...ch.textContent].forEach(c=>{if(c===' '){frag.appendChild(document.createTextNode(' '));}else{const s=document.createElement('span');s.className='h1-letter';s.textContent=c;frag.appendChild(s);}});ch.replaceWith(frag);}else splitNode(ch);});};\n  splitNode(h1);\n  if(reduce||!window.gsap){document.querySelectorAll('.vv [data-reveal],.vv .h1-letter').forEach(el=>{el.style.opacity=1;el.style.transform='none';});return;}\n  gsap.registerPlugin(ScrollTrigger);\n  gsap.to('.vv .h1-letter',{opacity:1,y:0,duration:.8,ease:'power2.out',stagger:.028,delay:.1});\n  document.querySelectorAll('.vv section').forEach(sec=>{\n    const items=sec.querySelectorAll('[data-reveal]');if(!items.length)return;\n    gsap.to(items,{opacity:1,y:0,duration:.7,ease:'power2.out',stagger:.07,scrollTrigger:{trigger:sec,start:'top 80%',once:true}});\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-09T10:00:15.873477+00:00",
